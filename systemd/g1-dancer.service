[Unit]
Description=Offline Unitree G1 dance controller
After=network-online.target bluetooth.target sound.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/Gibson/G1_Dancer
ExecStart=/home/unitree/miniconda3/envs/g1_dancer/bin/python -m g1_dancer.cli serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
